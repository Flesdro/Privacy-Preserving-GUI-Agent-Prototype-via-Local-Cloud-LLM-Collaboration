# OpenAI-compatible cloud LLM settings
#
# Copy this file to `.env` for local use if you want to keep credentials out of
# your shell history. Do not commit `.env`.

# API key for the cloud model provider.
CLOUD_LLM_API_KEY=

# Base URL for an OpenAI-compatible chat-completions API.
# Examples:
# CLOUD_LLM_BASE_URL=https://api.openai.com/v1
# CLOUD_LLM_BASE_URL=https://api.deepseek.com/v1
# CLOUD_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_LLM_BASE_URL=

# Model name understood by the provider.
# Examples:
# CLOUD_LLM_MODEL=gpt-4.1-mini
# CLOUD_LLM_MODEL=deepseek-chat
# CLOUD_LLM_MODEL=qwen-plus
CLOUD_LLM_MODEL=

# Optional: keep the default unless the provider is slow.
# This is not currently read by the CLI; it documents the adapter default.
CLOUD_LLM_TIMEOUT_SECONDS=60
